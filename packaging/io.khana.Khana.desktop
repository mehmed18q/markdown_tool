[Desktop Entry]
Type=Application
Version=1.0
Name=Khana
GenericName=Markdown and HTML Editor
Comment=Read and write Persian and English documents
Exec=/usr/bin/khana %F
TryExec=/usr/bin/khana
Icon=io.khana.Khana
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/markdown;text/x-markdown;text/html;text/plain;
StartupNotify=true
StartupWMClass=Khana
Keywords=Markdown;HTML;Editor;Persian;RTL;Flowchart;Table;
